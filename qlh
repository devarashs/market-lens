color i_cDanger = input.color(color.rgb(255, 50, 50), "Danger", group=GRP_C)
color i_cGrid = input.color(color.rgb(160, 100, 255), "Liq Grid", group=GRP_C)
color i_cRound = input.color(color.rgb(80, 80, 120), "Round Numbers", group=GRP_C)
color i_cHvn = input.color(color.rgb(255, 160, 50), "Volume Nodes", group=GRP_C)
color i_cEasyUp = input.color(color.rgb(0, 150, 255), "Easy Move Up", group=GRP_C)
color i_cEasyDn = input.color(color.rgb(160, 80, 255), "Easy Move Down", group=GRP_C)

// ── Volume Profile (DIY – works on all plans) ──
string GRP_VP = "Volume Profile"
bool i_showVP = input.bool(true, "Enable Volume Profile", group=GRP_VP)
int i_vpLen = input.int(50, "Profile Lookback Bars", minval=10, maxval=200, step=5, group=GRP_VP)
int i_vpRows = input.int(24, "Price Rows (resolution)", minval=8, maxval=50, step=2, group=GRP_VP, tooltip="More rows = finer profile, but heavier computation")
int i_vpVA = input.int(70, "Value Area %", minval=50, maxval=90, step=5, group=GRP_VP)
bool i_showPOC = input.bool(true, "Show POC Line", group=GRP_VP)
bool i_showVA = input.bool(true, "Show Value Area (VAH/VAL)", group=GRP_VP)
bool i_showImb = input.bool(true, "Show Imbalance Signals", group=GRP_VP)
float i_imbThresh = input.float(3.0, "Imbalance Ratio Threshold", minval=1.5, maxval=10.0, step=0.5, group=GRP_VP, tooltip="Buy/Sell ratio at POC row to flag imbalance")
bool i_showBars = input.bool(true, "Show Profile Bars", group=GRP_VP)
int i_vpBarW = input.int(40, "Bar Width (bars)", minval=10, maxval=150, step=5, group=GRP_VP, tooltip="Max width of the longest histogram bar in chart bars")
string i_vpSide = input.string("Right", "Bar Placement", options=["Left","Right"], group=GRP_VP)
color i_cVPbuy = input.color(color.rgb(0, 180, 140, 40), "Buy Volume Color", group=GRP_VP)
color i_cVPsell = input.color(color.rgb(200, 50, 80, 40), "Sell Volume Color", group=GRP_VP)
color i_cPOC = input.color(color.rgb(255, 215, 0), "POC Color", group=GRP_VP)
color i_cVAH = input.color(color.rgb(100, 180, 255), "VAH Color", group=GRP_VP)
color i_cVAL = input.color(color.rgb(100, 180, 255), "VAL Color", group=GRP_VP)

// ═══════════════════════════════════════════════════════════════════
// CORE CALCULATIONS
// ═══════════════════════════════════════════════════════════════════

float atrVal = ta.atr(14)

// Pivots
float ph = ta.pivothigh(high, i_pivL, i_pivR)
float pl = ta.pivotlow(low, i_pivL, i_pivR)

// Volume statistics
float volMu = ta.sma(volume, i_volLen)
float volSigma = ta.stdev(volume, i_volLen)
float volZ = volSigma > 0 ? (volume - volMu) / volSigma : 0.0
bool volAnom = volZ > i_volZ

// Price z-score (50-bar lookback)
float pMu = ta.sma(close, 50)
float pSigma = ta.stdev(close, 50)
float priceZ = pSigma > 0 ? (close - pMu) / pSigma : 0.0

// Candle anatomy
float bodySize = math.abs(close - open)
float rangeHL = high - low
float upperWick = high - math.max(open, close)
float lowerWick = math.min(open, close) - low
float bodyRatio = rangeHL > 0 ? bodySize / rangeHL : 0.0
float upWickR = rangeHL > 0 ? upperWick / rangeHL : 0.0
float dnWickR = rangeHL > 0 ? lowerWick / rangeHL : 0.0

// Absorption detection: big volume + tiny body + decent range = large player absorbing
bool isAbsorb = volZ > 1.0 and bodyRatio < i_absBody and rangeHL > atrVal \* 0.4
bool absorbBull = isAbsorb and lowerWick > upperWick
bool absorbBear = isAbsorb and upperWick > lowerWick

// ═══════════════════════════════════════════════════════════════════
// DIY VOLUME PROFILE (works on all plans – no request.footprint)
// ═══════════════════════════════════════════════════════════════════

// Build a volume profile by binning price into rows over the lookback window.
// Each bar's volume is assigned to the row containing its typical price (HLC/3),
// with a buy/sell split estimated from candle position.

float vpPOC = na
float vpVAH = na
float vpVAL = na
float vpPocBuyVol = na
float vpPocSellVol = na

// Persistent array to track histogram boxes so we can delete them before redrawing
var array<box> vpBoxes = array.new<box>(0)

if i_showVP and bar_index >= i_vpLen
// Determine the price range over the lookback
float pHi = ta.highest(high, i_vpLen)
float pLo = ta.lowest(low, i_vpLen)
float pRng = pHi - pLo

    if pRng > 0
        float rowH = pRng / i_vpRows

        // Accumulate volume into rows
        array<float> rowVol     = array.new<float>(i_vpRows, 0.0)
        array<float> rowBuyVol  = array.new<float>(i_vpRows, 0.0)
        array<float> rowSellVol = array.new<float>(i_vpRows, 0.0)

        for j = 0 to i_vpLen - 1
            float tp  = (high[j] + low[j] + close[j]) / 3.0
            int   row = math.floor((tp - pLo) / rowH)
            row := math.min(row, i_vpRows - 1)
            row := math.max(row, 0)

            float v = volume[j]
            array.set(rowVol, row, array.get(rowVol, row) + v)

            // Estimate buy/sell split from candle position
            float r = high[j] - low[j]
            float buyFrac = r > 0 ? (close[j] - low[j]) / r : 0.5
            array.set(rowBuyVol,  row, array.get(rowBuyVol,  row) + v * buyFrac)
            array.set(rowSellVol, row, array.get(rowSellVol, row) + v * (1.0 - buyFrac))

        // Find POC (row with highest volume)
        int   pocIdx  = 0
        float pocVol  = array.get(rowVol, 0)
        for k = 1 to i_vpRows - 1
            float rv = array.get(rowVol, k)
            if rv > pocVol
                pocVol := rv
                pocIdx := k

        vpPOC := pLo + (pocIdx + 0.5) * rowH
        vpPocBuyVol  := array.get(rowBuyVol,  pocIdx)
        vpPocSellVol := array.get(rowSellVol, pocIdx)

        // Compute Value Area (expand outward from POC until VA% of total volume)
        float totalVol = 0.0
        for k = 0 to i_vpRows - 1
            totalVol += array.get(rowVol, k)

        float vaTarget = totalVol * i_vpVA / 100.0
        float vaVol    = pocVol
        int   vaLo     = pocIdx
        int   vaHi     = pocIdx

        while vaVol < vaTarget and (vaLo > 0 or vaHi < i_vpRows - 1)
            float addLo = vaLo > 0             ? array.get(rowVol, vaLo - 1) : 0.0
            float addHi = vaHi < i_vpRows - 1  ? array.get(rowVol, vaHi + 1) : 0.0
            if addLo >= addHi and vaLo > 0
                vaLo  -= 1
                vaVol += addLo
            else if vaHi < i_vpRows - 1
                vaHi  += 1
                vaVol += addHi
            else
                vaLo  -= 1
                vaVol += addLo

        vpVAH := pLo + (vaHi + 1) * rowH
        vpVAL := pLo + vaLo * rowH

        // ── Draw histogram bars (only on last bar to avoid flicker/overload) ──
        if i_showBars and barstate.islast
            // Delete previous histogram boxes
            if array.size(vpBoxes) > 0
                for i = array.size(vpBoxes) - 1 to 0
                    box.delete(array.get(vpBoxes, i))
                array.clear(vpBoxes)

            // Anchor point for bars
            int anchor = i_vpSide == "Right" ? bar_index + 2 : bar_index - i_vpLen - 2

            for k = 0 to i_vpRows - 1
                float rv   = array.get(rowVol, k)
                float bv   = array.get(rowBuyVol, k)
                float sv   = array.get(rowSellVol, k)
                float rowBot = pLo + k * rowH
                float rowTop = pLo + (k + 1) * rowH

                // Scale bar width proportional to volume (max row = full width)
                int barLen = pocVol > 0 ? math.round(rv / pocVol * i_vpBarW) : 0
                if barLen < 1
                    continue

                // Buy portion width
                float buyPct = rv > 0 ? bv / rv : 0.5
                int buyLen   = math.max(1, math.round(buyPct * barLen))
                int sellLen  = math.max(0, barLen - buyLen)

                // Direction: Right = bars extend right from anchor; Left = extend left
                int buyL  = 0
                int buyR  = 0
                int sellL = 0
                int sellR = 0
                if i_vpSide == "Right"
                    buyL  := anchor
                    buyR  := anchor + buyLen
                    sellL := anchor + buyLen
                    sellR := anchor + buyLen + sellLen
                else
                    sellR := anchor
                    sellL := anchor - sellLen
                    buyR  := sellL
                    buyL  := sellL - buyLen

                // POC row gets brighter colors
                bool isPOC = k == pocIdx
                color cBuy  = isPOC ? color.new(i_cPOC, 20) : i_cVPbuy
                color cSell = isPOC ? color.new(i_cPOC, 50) : i_cVPsell

                // Draw buy volume box
                if buyLen > 0
                    array.push(vpBoxes, box.new(buyL, rowTop, buyR, rowBot,
                         border_color=color.new(cBuy, 80), bgcolor=cBuy, border_width=0))
                // Draw sell volume box
                if sellLen > 0
                    array.push(vpBoxes, box.new(sellL, rowTop, sellR, rowBot,
                         border_color=color.new(cSell, 80), bgcolor=cSell, border_width=0))

// ── POC-row imbalance detection ──
float pocRatio = not na(vpPocSellVol) and vpPocSellVol > 0 ? vpPocBuyVol / vpPocSellVol : na
bool fpBuyImb = i_showImb and not na(pocRatio) and pocRatio >= i_imbThresh
bool fpSellImb = i_showImb and not na(pocRatio) and pocRatio <= 1.0 / i_imbThresh

// ── Delta proxy ──
// delta ≈ volume × (2×(close-low)/(high-low) - 1) range [-vol, +vol]
float rawDelta = rangeHL > 0 ? volume _ (2.0 _ (close - low) / rangeHL - 1.0) : 0.0
var float cumDelta = 0.0
cumDelta += rawDelta
float cumDeltaSmooth = ta.ema(cumDelta, i_deltaLen)

// Delta divergence: price making new high but cumulative delta declining (or vice versa)
bool deltaBearDiv = high > ta.highest(high, 10)[1] and cumDeltaSmooth < cumDeltaSmooth[5]
bool deltaBullDiv = low < ta.lowest(low, 10)[1] and cumDeltaSmooth > cumDeltaSmooth[5]

// Volatility squeeze: Bollinger Bands inside Keltner Channels
float bbBasis = ta.sma(close, i_bbLen)
float bbDev = ta.stdev(close, i_bbLen)
float bbUp = bbBasis + 2 _ bbDev
float bbDn = bbBasis - 2 _ bbDev
float kcBasis = ta.ema(close, i_kcLen)
float kcRng = ta.atr(i_kcLen)
float kcUp = kcBasis + i_kcMult _ kcRng
float kcDn = kcBasis - i_kcMult _ kcRng
bool sqzOn = bbDn > kcDn and bbUp < kcUp
float sqzMom = ta.linreg(close - bbBasis, i_bbLen, 0)
bool sqzFire = sqzOn[1] and not sqzOn
float sqzWidthRatio = (kcUp - kcDn) > 0 ? (bbUp - bbDn) / (kcUp - kcDn) : na
bool easyMove = i_showEasyMove and not na(sqzWidthRatio) and sqzWidthRatio <= i_easyRatio

// Realized volatility percentile
float rets = math.log(close / close[1])
float realVol = ta.stdev(rets, 20) _ math.sqrt(252) _ 100
float rvPct = ta.percentile_nearest_rank(realVol, 100, 80)
bool highVol = realVol > rvPct

// Momentum exhaustion: new extreme + RSI divergence + ROC deceleration
float rsiVal = ta.rsi(close, i_rsiLen)
float rocVal = ta.roc(close, i_rocLen)
bool rocDec = math.abs(rocVal) < math.abs(rocVal[1]) and math.abs(rocVal[1]) < math.abs(rocVal[2])
bool bearExh = i_showExh and high > ta.highest(high, 10)[1] and rsiVal < rsiVal[3] and rocDec and rsiVal > 60
bool bullExh = i_showExh and low < ta.lowest(low, 10)[1] and rsiVal > rsiVal[3] and rocDec and rsiVal < 40

// ═══════════════════════════════════════════════════════════════════
// STOP CLUSTER ZONES (boxes around estimated retail stop regions)
// ═══════════════════════════════════════════════════════════════════

var array<float> clH = array.new<float>(0)
var array<int> clHbar = array.new<int>(0)
var array<box> clHbox = array.new<box>(0)
var array<float> clL = array.new<float>(0)
var array<int> clLbar = array.new<int>(0)
var array<box> clLbox = array.new<box>(0)

// New pivot high → estimated stop cluster sits just above
if not na(ph)
float zBot = ph
float zTop = ph + atrVal \* i_stopBuf
int xS = bar_index - i_pivR
box b = box.new(xS, zTop, bar_index + 40, zBot, border_color=color.new(i_cBear, 60), bgcolor=color.new(i_cBear, 92), border_width=1)
array.push(clH, ph)
array.push(clHbar, xS)
array.push(clHbox, b)
if array.size(clH) > i_maxCl
array.shift(clH)
array.shift(clHbar)
box.delete(array.shift(clHbox))

// New pivot low → estimated stop cluster sits just below
if not na(pl)
float zTop = pl
float zBot = pl - atrVal \* i_stopBuf
int xS = bar_index - i_pivR
box b = box.new(xS, zTop, bar_index + 40, zBot, border_color=color.new(i_cBull, 60), bgcolor=color.new(i_cBull, 92), border_width=1)
array.push(clL, pl)
array.push(clLbar, xS)
array.push(clLbox, b)
if array.size(clL) > i_maxCl
array.shift(clL)
array.shift(clLbar)
box.delete(array.shift(clLbox))

// Extend all active cluster boxes to current bar + offset
if array.size(clHbox) > 0
for i = 0 to array.size(clHbox) - 1
box.set_right(array.get(clHbox, i), bar_index + 40)

if array.size(clLbox) > 0
for i = 0 to array.size(clLbox) - 1
box.set_right(array.get(clLbox, i), bar_index + 40)

// Remove clusters that have been fully swept through (invalidated)
if array.size(clH) > 0
int sz = array.size(clH)
for i = sz - 1 to 0
float lvl = array.get(clH, i)
if close > lvl + atrVal _ i_stopBuf _ 2
array.remove(clH, i)
array.remove(clHbar, i)
box.delete(array.get(clHbox, i))
array.remove(clHbox, i)

if array.size(clL) > 0
int sz = array.size(clL)
for i = sz - 1 to 0
float lvl = array.get(clL, i)
if close < lvl - atrVal _ i_stopBuf _ 2
array.remove(clL, i)
array.remove(clLbar, i)
box.delete(array.get(clLbox, i))
array.remove(clLbox, i)

// ═══════════════════════════════════════════════════════════════════
// ROUND-NUMBER MAGNETS (retail gravitates to round numbers)
// ═══════════════════════════════════════════════════════════════════

var line rnUp1 = na
var line rnUp2 = na
var line rnDn1 = na
var line rnDn2 = na
var bool rndInitialized = false

if i_showRnd
float mag = math.pow(10, math.floor(math.log10(close)))
float step = mag / 10
if step < syminfo.mintick
step := syminfo.mintick
float base = math.floor(close / step) _ step
float rU1 = base + step
float rU2 = base + step _ 2
float rD1 = base
float rD2 = base - step
int bS = bar_index - 80
int bE = bar_index + 40

    if not rndInitialized
        rnUp1 := line.new(bS, rU1, bE, rU1, color=color.new(i_cRound, 50), style=line.style_dotted, width=1)
        rnUp2 := line.new(bS, rU2, bE, rU2, color=color.new(i_cRound, 65), style=line.style_dotted, width=1)
        rnDn1 := line.new(bS, rD1, bE, rD1, color=color.new(i_cRound, 50), style=line.style_dotted, width=1)
        rnDn2 := line.new(bS, rD2, bE, rD2, color=color.new(i_cRound, 65), style=line.style_dotted, width=1)
        rndInitialized := true
    else
        line.set_xy1(rnUp1, bS, rU1)
        line.set_xy2(rnUp1, bE, rU1)
        line.set_xy1(rnUp2, bS, rU2)
        line.set_xy2(rnUp2, bE, rU2)
        line.set_xy1(rnDn1, bS, rD1)
        line.set_xy2(rnDn1, bE, rD1)
        line.set_xy1(rnDn2, bS, rD2)
        line.set_xy2(rnDn2, bE, rD2)

// ═══════════════════════════════════════════════════════════════════
// HIGH-VOLUME NODES (VPOC proxy – price levels with heaviest trade)
// ═══════════════════════════════════════════════════════════════════

var array<line> hvnLines = array.new<line>(0)
var bool hvnInitialized = false

// Initialize HVN lines once on first bars
if not hvnInitialized and bar_index > i_hvnLen
for n = 0 to i_hvnCount - 1
array.push(hvnLines, line.new(bar_index, close, bar_index + 1, close,
color=color.new(i_cHvn, 100), width=1, style=line.style_dashed))
hvnInitialized := true

// Update HVN lines every bar (not just islast)
if hvnInitialized and bar_index > i_hvnLen
array<float> hvnLevels = array.new<float>(0)
array<float> volArr = array.new<float>(0)
array<int> idxArr = array.new<int>(0)
for j = 0 to i_hvnLen - 1
array.push(volArr, volume[j])
array.push(idxArr, j)

    for n = 0 to i_hvnCount - 1
        if array.size(volArr) == 0
            break
        int   maxIdx = 0
        float maxVol = array.get(volArr, 0)
        if array.size(volArr) > 1
            for k = 1 to array.size(volArr) - 1
                if array.get(volArr, k) > maxVol
                    maxVol := array.get(volArr, k)
                    maxIdx := k
        int   offset = array.get(idxArr, maxIdx)
        float hvnLvl = (high[offset] + low[offset] + close[offset]) / 3.0
        array.push(hvnLevels, hvnLvl)
        array.remove(volArr, maxIdx)
        array.remove(idxArr, maxIdx)

    // Update pre-allocated lines in place (no flicker)
    int bStart = bar_index - i_hvnLen
    int bEnd   = bar_index + 30
    for n = 0 to i_hvnCount - 1
        line ln = array.get(hvnLines, n)
        if n < array.size(hvnLevels)
            float lvl = array.get(hvnLevels, n)
            int   wid = n == 0 ? 2 : 1
            line.set_xy1(ln, bStart, lvl)
            line.set_xy2(ln, bEnd, lvl)
            line.set_color(ln, color.new(i_cHvn, 30 + n * 15))
            line.set_width(ln, wid)
        else
            line.set_color(ln, color.new(i_cHvn, 100))

// ═══════════════════════════════════════════════════════════════════
// LIQUIDATION GRID (estimated liq prices per leverage tier)
// ═══════════════════════════════════════════════════════════════════

// Anchor price
float anchorP = switch i_anchor
"EMA" => ta.ema(close, i_anchLen)
"SMA" => ta.sma(close, i_anchLen)
=> ta.vwap(hlc3)

// Liquidation price formulas:
// Long liq ≈ entry × (1 − 1/leverage)
// Short liq ≈ entry × (1 + 1/leverage)
float l5L = anchorP _ (1 - 1.0 / 5)
float l5S = anchorP _ (1 + 1.0 / 5)
float l10L = anchorP _ (1 - 1.0 / 10)
float l10S = anchorP _ (1 + 1.0 / 10)
float l25L = anchorP _ (1 - 1.0 / 25)
float l25S = anchorP _ (1 + 1.0 / 25)
float l50L = anchorP _ (1 - 1.0 / 50)
float l50S = anchorP _ (1 + 1.0 / 50)
float l100L = anchorP _ (1 - 1.0 / 100)
float l100S = anchorP _ (1 + 1.0 / 100)

// Liq grid drawn with lines + boxes (no plot outputs consumed)
var line gAnch = na
var line g5L = na
var line g5S = na
var line g10L = na
var line g10S = na
var line g25L = na
var line g25S = na
var line g50L = na
var line g50S = na
var line g100L = na
var line g100S = na
var box bx25 = na
var box bx50 = na

f_gridLine(ref, y, col, w) =>
line result = ref
if na(ref)
result := line.new(bar_index, y, bar_index + 1, y, color=col, width=w, style=line.style_solid, extend=extend.both)
else
line.set_y1(result, y)
line.set_y2(result, y)
result

f_gridBox(ref, yTop, yBot, col) =>
box result = ref
if na(ref)
result := box.new(bar_index - 200, yTop, bar_index + 50, yBot, border_color=na, bgcolor=col)
else
box.set_top(result, yTop)
box.set_bottom(result, yBot)
box.set_left(result, bar_index - 200)
box.set_right(result, bar_index + 50)
result

if i_showGrid
gAnch := f_gridLine(gAnch, anchorP, color.new(i_cNeut, 30), 1)
if i_show5x
g5L := f_gridLine(g5L, l5L, color.new(i_cGrid, 75), 1)
g5S := f_gridLine(g5S, l5S, color.new(i_cGrid, 75), 1)
if i_show10x
g10L := f_gridLine(g10L, l10L, color.new(i_cGrid, 65), 1)
g10S := f_gridLine(g10S, l10S, color.new(i_cGrid, 65), 1)
if i_show25x
g25L := f_gridLine(g25L, l25L, color.new(i_cGrid, 55), 1)
g25S := f_gridLine(g25S, l25S, color.new(i_cGrid, 55), 1)
bx25 := f_gridBox(bx25, l25S, l25L, color.new(i_cGrid, 96))
if i_show50x
g50L := f_gridLine(g50L, l50L, color.new(i_cDanger, 55), 1)
g50S := f_gridLine(g50S, l50S, color.new(i_cDanger, 55), 1)
bx50 := f_gridBox(bx50, l50S, l50L, color.new(i_cDanger, 96))
if i_show100x
g100L := f_gridLine(g100L, l100L, color.new(i_cDanger, 45), 1)
g100S := f_gridLine(g100S, l100S, color.new(i_cDanger, 45), 1)

// ═══════════════════════════════════════════════════════════════════
// SWEEP DETECTION (price pierces cluster zone → wick rejection)
// ═══════════════════════════════════════════════════════════════════

bool sweepBull = false
bool sweepBear = false

if i_showSw and array.size(clH) > 0
for i = 0 to array.size(clH) - 1
float lvl = array.get(clH, i)
// High entered the stop zone above a swing high, but close stayed below → swept sell-stops
if high >= lvl and close < lvl and upWickR >= i_swWick
if not i_swVol or volAnom
sweepBear := true
break

if i_showSw and array.size(clL) > 0
for i = 0 to array.size(clL) - 1
float lvl = array.get(clL, i)
// Low entered the stop zone below a swing low, but close stayed above → swept buy-stops
if low <= lvl and close > lvl and dnWickR >= i_swWick
if not i_swVol or volAnom
sweepBull := true
break

// ═══════════════════════════════════════════════════════════════════
// CANDLE COLORING
// ═══════════════════════════════════════════════════════════════════

color cCol = isAbsorb ? i_cWarn :
volAnom ? (close > open ? i_cBull : i_cBear) :
close > open ? color.new(i_cBull, 30) : color.new(i_cBear, 30)

plotcandle(open, high, low, close, color=cCol, wickcolor=color.new(cCol, 20), bordercolor=cCol, title="Candles")

// ═══════════════════════════════════════════════════════════════════
// BACKGROUND HIGHLIGHTS
// ═══════════════════════════════════════════════════════════════════

// Squeeze regime background
bgcolor(i_showSqz and sqzOn ? color.new(i_cWarn, 94) : na, title="Squeeze Active")

// Directional compression background: probable squeeze / easy-to-move price
bgcolor(easyMove ? color.new(sqzMom >= 0 ? i_cEasyUp : i_cEasyDn, 90) : na, title="Easy Move / Probable Squeeze")

// Extreme price z-score (price far from mean = crowded positioning = liq risk)
bgcolor(math.abs(priceZ) > 2.5 ? color.new(i_cDanger, 95) : na, title="Extreme Price Deviation")

// ═══════════════════════════════════════════════════════════════════
// PLOT SIGNALS
// ═══════════════════════════════════════════════════════════════════

// Sweeps
plotshape(sweepBear, "Bear Sweep", shape.triangledown, location.abovebar, i_cBear, size=size.normal)
plotshape(sweepBull, "Bull Sweep", shape.triangleup, location.belowbar, i_cBull, size=size.normal)

// Absorption
plotshape(i_showAbs and absorbBull, "Bull Absorb", shape.diamond, location.belowbar, i_cWarn, size=size.small)
plotshape(i_showAbs and absorbBear, "Bear Absorb", shape.diamond, location.abovebar, i_cWarn, size=size.small)

// Exhaustion (momentum + RSI divergence + ROC deceleration)
plotshape(bearExh, "Bear Exhaustion", shape.xcross, location.abovebar, i_cDanger, size=size.small)
plotshape(bullExh, "Bull Exhaustion", shape.xcross, location.belowbar, i_cDanger, size=size.small)

// Delta divergence
plotshape(i_showDelta and deltaBearDiv and not deltaBearDiv[1], "Delta Bear Div", shape.flag, location.abovebar, i_cBear, size=size.tiny)
plotshape(i_showDelta and deltaBullDiv and not deltaBullDiv[1], "Delta Bull Div", shape.flag, location.belowbar, i_cBull, size=size.tiny)

// Squeeze release dot (direction = squeeze momentum direction)
plotshape(i_showSqz and sqzFire, "Squeeze Fire", shape.circle, location.belowbar,
sqzMom > 0 ? i_cBull : i_cBear, size=size.tiny)

// Volume Profile imbalance signals
plotshape(fpBuyImb and not fpBuyImb[1], "VP Buy Imbalance", shape.arrowup, location.belowbar, i_cBull, size=size.small, text="IMB", textcolor=i_cBull)
plotshape(fpSellImb and not fpSellImb[1],"VP Sell Imbalance", shape.arrowdown, location.abovebar, i_cBear, size=size.small, text="IMB", textcolor=i_cBear)

// ═══════════════════════════════════════════════════════════════════
// VOLUME PROFILE POC / VALUE AREA LINES
// ═══════════════════════════════════════════════════════════════════

var line lnPOC = na
var line lnVAH = na
var line lnVAL = na

int vpStart = bar_index - i_vpLen
int vpEnd = bar_index + 30

if i_showVP and i_showPOC and not na(vpPOC)
if na(lnPOC)
lnPOC := line.new(vpStart, vpPOC, vpEnd, vpPOC, color=i_cPOC, width=2, style=line.style_solid)
else
line.set_xy1(lnPOC, vpStart, vpPOC)
line.set_xy2(lnPOC, vpEnd, vpPOC)

if i_showVP and i_showVA and not na(vpVAH)
if na(lnVAH)
lnVAH := line.new(vpStart, vpVAH, vpEnd, vpVAH, color=i_cVAH, width=1, style=line.style_dashed)
else
line.set_xy1(lnVAH, vpStart, vpVAH)
line.set_xy2(lnVAH, vpEnd, vpVAH)

if i_showVP and i_showVA and not na(vpVAL)
if na(lnVAL)
lnVAL := line.new(vpStart, vpVAL, vpEnd, vpVAL, color=i_cVAL, width=1, style=line.style_dashed)
else
line.set_xy1(lnVAL, vpStart, vpVAL)
line.set_xy2(lnVAL, vpEnd, vpVAL)

// ═══════════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════════

alertcondition(sweepBear, "Bearish Stop Sweep", "Swept above stop cluster → bearish wick rejection")
alertcondition(sweepBull, "Bullish Stop Sweep", "Swept below stop cluster → bullish wick rejection")
alertcondition(volAnom, "Volume Anomaly", "Volume z-score exceeded threshold")
alertcondition(isAbsorb, "Order Absorption", "Absorption candle detected: high volume + tiny body")
alertcondition(bearExh, "Bearish Exhaustion", "Momentum exhaustion at highs — reversal setup")
alertcondition(bullExh, "Bullish Exhaustion", "Momentum exhaustion at lows — reversal setup")
alertcondition(sqzOn and not sqzOn[1], "Squeeze Entry", "Volatility squeeze started — expansion imminent")
alertcondition(sqzFire, "Squeeze Release", "Volatility squeeze released — directional move")
alertcondition(deltaBearDiv and not deltaBearDiv[1],"Delta Bear Diverge", "Price high but delta declining — hidden selling")
alertcondition(deltaBullDiv and not deltaBullDiv[1],"Delta Bull Diverge", "Price low but delta rising — hidden buying")
alertcondition(math.abs(priceZ) > 2.5, "Extreme Deviation", "Price >2.5σ from mean — crowded positioning risk")
alertcondition(fpBuyImb and not fpBuyImb[1], "VP Buy Imbalance", "Volume Profile POC buy imbalance — aggressive buyers at POC")
alertcondition(fpSellImb and not fpSellImb[1], "VP Sell Imbalance", "Volume Profile POC sell imbalance — aggressive sellers at POC")
