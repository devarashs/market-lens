// ── Colors ──
string GRP_C = "Colors"
color i_cBull = input.color(color.rgb(0, 230, 180), "Bullish", group=GRP_C)
color i_cBear = input.color(color.rgb(230, 50, 90), "Bearish", group=GRP_C)
color i_cNeut = input.color(color.rgb(130, 140, 170), "Neutral", group=GRP_C)
